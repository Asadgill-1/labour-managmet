SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# true once the project's email templates carry {{ .Token }} (custom SMTP, T19d)
EMAIL_CODES=
# The public half of the licence signing key, from one GET of <SUPABASE_URL>/functions/v1/licence (T21, D-074). Not a secret
LICENCE_KEY=
# The public half of the platform's recovery key, printed by `dart run tool/recovery_key.dart make` (T20d, D-072). Not a secret;
# the private half never goes here. Empty or not a key: no cloud copy, and the Backup page says the cloud backup is unavailable
RECOVERY_KEY=
# true only in a Play Store build: Plan lein and the trial note stay out until the policy review (BILL-07)
PLAY_STORE=
