SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# true once the project's email templates carry {{ .Token }} (custom SMTP, T19d)
EMAIL_CODES=
# The public half of the licence signing key, from one GET of <SUPABASE_URL>/functions/v1/licence (T21, D-074). Not a secret
LICENCE_KEY=
# true only in a Play Store build: Plan lein and the trial note stay out until the policy review (BILL-07)
PLAY_STORE=
